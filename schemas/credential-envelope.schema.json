{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.dev/schemas/secrets/credential-envelope/v1",
  "title": "Wellmanifest Encrypted Credential Envelope v1",
  "description": "Authenticated symmetric encryption envelope for at-rest credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "algorithm",
    "iv",
    "tag",
    "ciphertext"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "wellmanifest.secrets/envelope/v1"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "algorithm": {
      "type": "string",
      "enum": [
        "aes-256-gcm"
      ],
      "description": "Authenticated symmetric cipher. Non-authenticated ciphers fail closed."
    },
    "kdf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "salt"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["scrypt", "sha256", "pbkdf2"]
        },
        "salt": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,}$",
          "description": "Base64 or base64url encoded cryptographic salt of at least 12 bytes."
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "n": {"type": "integer", "minimum": 1024, "default": 16384},
            "r": {"type": "integer", "minimum": 1, "default": 8},
            "p": {"type": "integer", "minimum": 1, "default": 1},
            "iterations": {"type": "integer", "minimum": 100000}
          }
        }
      }
    },
    "iv": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,24}$",
      "description": "12-byte initialization vector, encoded in base64 or base64url."
    },
    "tag": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{20,24}$",
      "description": "16-byte GCM authentication tag, encoded in base64 or base64url."
    },
    "ciphertext": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Base64 or base64url encoded ciphertext payload."
    },
    "key_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,63}$",
      "description": "Optional key identifier or fingerprint."
    }
  }
}
