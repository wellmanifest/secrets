{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.dev/schemas/secrets/secret-lease/v1",
  "title": "Wellmanifest Bounded Secret Lease Receipt v1",
  "description": "Receipt structure for short-lived secret leases granted at the execution boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "lease_id",
    "entry_id",
    "field",
    "origin",
    "actor",
    "purpose",
    "expires_in_seconds",
    "granted_at"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "wellmanifest.secrets/lease/v1"
    },
    "lease_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Unique lease identifier."
    },
    "entry_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,159}$"
    },
    "field": {
      "type": "string",
      "enum": [
        "api_key",
        "secret_key",
        "access_token",
        "username",
        "password",
        "app_key",
        "totp_seed"
      ]
    },
    "origin": {
      "type": "string",
      "format": "uri"
    },
    "actor": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+:[a-z0-9._:-]+$"
    },
    "purpose": {
      "type": "string",
      "minLength": 4,
      "maxLength": 200
    },
    "ticket_id": {
      "type": "string"
    },
    "grant_id": {
      "type": "string"
    },
    "expires_in_seconds": {
      "type": "integer",
      "minimum": 5,
      "maximum": 86400
    },
    "granted_at": {
      "type": "string",
      "format": "date-time"
    },
    "masked_preview": {
      "type": "string",
      "const": "••••••••",
      "description": "Guaranteed masking for audit streams and UI views."
    }
  }
}
